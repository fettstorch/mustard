# Default local secrets for `supabase functions serve` (NOT used by deployed functions).
# Supabase loads the copied `.env` automatically; the local E2E npm scripts rely
# on that default and deliberately do not pass `--env-file`.
# Copy this file to `.env` in the same directory and fill in the needed values:
#   cp supabase/functions/.env.example supabase/functions/.env
#
# `.env` is gitignored because it holds real GitHub OAuth client secrets.
# Production secrets are set separately via:
#   supabase secrets set JWT_SIGNING_SECRET=<Dashboard → Settings → API → JWT Secret>

# Fixed well-known default JWT secret of every local Supabase instance.
# Safe to commit — it only signs tokens for the local dev stack.
JWT_SIGNING_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# GitHub OAuth (only needed when testing GitHub connect locally).
# Get these from your GitHub OAuth apps (one per browser due to single redirect URI).
GITHUB_CLIENT_ID=your-chrome-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-chrome-oauth-app-client-secret
GITHUB_CLIENT_ID_FIREFOX=your-firefox-oauth-app-client-id
GITHUB_CLIENT_SECRET_FIREFOX=your-firefox-oauth-app-client-secret

# AT Protocol confidential-client private key (RFC 7523 private_key_jwt).
# auth-bridge signs a client assertion with this on every PAR/token/refresh
# call to an atproto Authorization Server. The PUBLIC half must be published
# in docs/client-metadata.json's `jwks` (matched by `kid`) — the AS fetches
# that file to verify the assertion, so the two must always be updated together.
#
# Generate a new ES256 pair (Deno isn't required — plain Node works):
#   node -e "
#     const { publicKey, privateKey } = require('crypto').generateKeyPairSync('ec', { namedCurve: 'P-256' });
#     const kid = crypto.randomUUID();
#     const toJwk = (k) => ({ ...k.export({ format: 'jwk' }), kid, use: 'sig', alg: 'ES256' });
#     console.log('private:', JSON.stringify(toJwk(privateKey)));
#     console.log('public: ', JSON.stringify(toJwk(publicKey)));
#   "
# Rotation: publish the new public JWK in client-metadata.json ALONGSIDE the
# old one (jwks.keys is an array) for a transition window, deploy, THEN set
# this secret to the new private key, THEN remove the old public JWK once no
# in-flight session references the old `kid` anymore.
#
# Set in production with: supabase secrets set ATPROTO_CLIENT_PRIVATE_JWK='<value, as one line>'
ATPROTO_CLIENT_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"...","use":"sig","alg":"ES256"}

# Client metadata override for the local live Bluesky E2E. The local runner
# requires this value so tests use the dedicated metadata and cannot depend on
# or alter the production client's rollout state. It publishes the public half
# matching ATPROTO_CLIENT_PRIVATE_JWK above.
ATPROTO_CLIENT_ID=https://fettstorch.github.io/mustard/client-metadata-test.json
