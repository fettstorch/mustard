# Minimal, tracked Edge Function environment for CI's deterministic authenticated
# E2E suite. CI also copies this file to a temporary env and appends repository
# secrets for the live Bluesky job.
#
# Do not use this file for local test commands: `npm run test:e2e:auth`,
# `npm run test:e2e:auth:bluesky`, and `npm run test:e2e:all` start
# `supabase functions serve` without `--env-file`, so Supabase automatically
# loads the ignored `supabase/functions/.env` instead.
#
# This fixed signing secret is safe to commit and matches the local Supabase CLI stack.
JWT_SIGNING_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
