# Local Playwright secrets for the live Bluesky OAuth E2E only.
# Copy this file to `.env.e2e.local`; the destination is ignored by `*.local`.
# These values are read by `playwright.bluesky-auth.config.ts` and are never
# exposed to Edge Functions or compiled into the extension.
#
# Use a dedicated Bluesky account without 2FA. Browser OAuth needs the account
# password; an app password cannot complete this flow.
BLUESKY_E2E_HANDLE=mustard-test.bsky.social
BLUESKY_E2E_PASSWORD=real-account-password
